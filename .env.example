# Get a bot token from @BotFather. Never share it publicly.
BOT_TOKEN=replace_with_your_telegram_bot_token

# Optional: private group/channel ID where admin logs should be forwarded.
# Add the bot to that destination and grant permission to send messages.
LOG_CHAT_ID=-1004314134570

# Optional: your Telegram numeric user ID. Leave 0 to use group-admin checks only.
BOT_OWNER_ID=0

DATABASE_PATH=saint_guard.sqlite3
SPAM_WINDOW_SECONDS=8
SPAM_MESSAGE_LIMIT=6
SPAM_MUTE_MINUTES=5
LOG_LEVEL=INFO
